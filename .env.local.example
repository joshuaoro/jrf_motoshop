# ============================================================
# JRF Motorcycle Parts - LOCAL developer overrides
#
#   cp .env.local.example .env.local
#
# .env.local wins over .env, and both lose to variables already exported in
# your shell. Precedence, highest first:
#
#     real environment  >  .env.local  >  .env
#
# Why this file exists: `.env` names the deployment database. Without a local
# override, every `flask` command, every test run and every stray script on
# this machine talks to production. Point yourself somewhere disposable here
# and leave `.env` alone.
#
# .env.local is git-ignored. Never commit it.
# ============================================================

FLASK_ENV=development

# ------------------------------------------------------------
# A throwaway database
# ------------------------------------------------------------
# Option A - the Postgres from docker-compose (recommended: same engine as
# production, so migrations and SQL behave identically):
#
#     docker compose up -d postgres
#
# It binds to 127.0.0.1 only. POSTGRES_PASSWORD comes from your .env.
DATABASE_URL=postgresql://jrf_user:changeme@127.0.0.1:5432/jrf_motoshop

# Option B - a local SQLite file. No server to run, but SQLite differs from
# PostgreSQL in enough ways (row locking, REINDEX, date functions) that some
# code paths will not be exercised faithfully.
# DATABASE_URL=sqlite:///local_dev.db

# ------------------------------------------------------------
# Convenience for development
# ------------------------------------------------------------
SECRET_KEY=local-development-secret-key-not-used-in-production
LOG_LEVEL=DEBUG
LOG_TO_FILE=false

# Rate limiting gets in the way when you are clicking around; turn it off
# locally, never in a deployment.
RATELIMIT_ENABLED=false

# Set this if you have Redis running locally, otherwise leave it out.
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# First-time setup against the local database
# ------------------------------------------------------------
#   flask --app wsgi db upgrade
#   flask --app wsgi init-db
#   flask --app wsgi seed-data
#
# The startup banner always prints which database it connected to, and warns
# when a development app is pointed at a remote one. Check it if in doubt.
