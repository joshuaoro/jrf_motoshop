# ============================================================
# JRF Motorcycle Parts - environment configuration
# Copy to .env and fill in. NEVER commit .env.
#
# This file describes the DEPLOYMENT environment. For local development, do
# not edit these values - copy .env.local.example to .env.local instead and
# point that at a throwaway database. Precedence, highest first:
#
#     real environment  >  .env.local  >  .env
#
# Without a .env.local, every local `flask` command and script talks to
# whatever DATABASE_URL is set below.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
# development | production | testing
FLASK_ENV=development

# Required in production (startup fails without it, minimum 32 characters).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# ------------------------------------------------------------
# DATABASE (Supabase PostgreSQL - the single source of truth)
# ------------------------------------------------------------
# The whole application stores its data in Supabase PostgreSQL, so DATABASE_URL
# must point at your Supabase project. The project URL and keys below are kept
# optional/placeholder here so nothing real is ever committed - fill .env
# (git-ignored) with them if you enable Supabase Auth / Storage / Realtime JS.

# Supabase transaction pooler (port 6543) resolves over IPv4 and is the
# recommended choice for local development:
DATABASE_URL=postgresql://postgres.<project>:your-password@aws-0-<region>.pooler.supabase.com:6543/postgres

# Direct connection (resolves over IPv6 only):
# DATABASE_URL=postgresql://postgres:your-password@db.<project>.supabase.co:5432/postgres

# Discrete components, used only when DATABASE_URL is unset.
# Passwords are URL-quoted automatically, so special characters are fine.
# SUPABASE_DB_HOST=db.<project>.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-password
# SUPABASE_DB_NAME=postgres

# Supabase project (for Supabase JS: Auth / Storage / Realtime). Not consumed
# by the Flask app today, but documented here for future use.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=paste-your-publishable-anon-key

# Connection pool tuning
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------
# REDIS (rate-limit storage and Celery broker)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Rate-limit counter storage. Defaults to REDIS_URL, then to in-process
# memory. Memory storage is per-worker, so set this to Redis whenever you
# run more than one gunicorn worker or the limits will not be shared.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# ------------------------------------------------------------
# RATE LIMITS (flask-limiter syntax)
# ------------------------------------------------------------
# RATELIMIT_ENABLED=true
# RATELIMIT_LOGIN=10 per minute
# RATELIMIT_API=120 per minute
# RATELIMIT_DEFAULT=600 per minute

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
# Session lifetime in seconds.
# SESSION_LIFETIME_SECONDS=3600
# Maximum request body in bytes (default 8 MB).
# MAX_CONTENT_LENGTH=8388608
# Set false when the app is exposed directly, with no reverse proxy in front.
# Leaving it true without a proxy lets clients spoof X-Forwarded-For and
# thereby evade per-IP rate limiting.
# TRUST_PROXY_HEADERS=true

# ------------------------------------------------------------
# LOGGING & STORAGE
# ------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_DIR=./logs
# LOG_TO_FILE=true
# BACKUP_DIR=./backups

# ------------------------------------------------------------
# PAGINATION
# ------------------------------------------------------------
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# ------------------------------------------------------------
# DOCKER COMPOSE ONLY
# ------------------------------------------------------------
# Password for the bundled postgres service (required by docker compose).
POSTGRES_PASSWORD=change-me
# Host port the app is published on.
# APP_PORT=5000
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
